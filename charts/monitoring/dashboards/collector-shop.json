{
  "uid": "collector-shop-observability",
  "title": "Collector.shop - Observabilité",
  "tags": ["collector"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API - requêtes/s par statut HTTP",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status) (rate(nginx_ingress_controller_requests{ingress=`collector-catalog-api`}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API - latence p50 / p95",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{ingress=`collector-catalog-api`}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{ingress=`collector-catalog-api`}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API - taux d'erreurs 5xx",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(nginx_ingress_controller_requests{ingress=`collector-catalog-api`, status=~`5..`}[5m])) / sum(rate(nginx_ingress_controller_requests{ingress=`collector-catalog-api`}[5m]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Articles contrôlés (résultat du worker)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({namespace=`default`, pod=~`collector-catalog-api-.*`} |= `-> PUBLISHED` [5m]))",
          "legendFormat": "PUBLISHED",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({namespace=`default`, pod=~`collector-catalog-api-.*`} |= `-> REJECTED` [5m]))",
          "legendFormat": "REJECTED",
          "queryType": "range"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Erreurs applicatives (logs ERROR)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (pod) (count_over_time({namespace=`default`, pod=~`collector-.*`} |= ` ERROR ` [5m]))",
          "legendFormat": "{{pod}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker - événements de modération traités",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({namespace=`default`, pod=~`collector-moderation-worker-.*`} |= `articleId=` [5m]))",
          "legendFormat": "événements",
          "queryType": "range"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Journal de l'API - décisions de modération",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{namespace=`default`, pod=~`collector-catalog-api-.*`} |= `->`",
          "queryType": "range"
        }
      ],
      "options": {}
    }
  ]
}
