# Copie ce fichier en .env avant de lancer docker compose up -d
# .env est gitignore : ne jamais committer de vraies valeurs, cible finale = Vault

# PostgreSQL
POSTGRES_USER=collector
POSTGRES_PASSWORD=collector_dev_password
POSTGRES_DB=collector

# RabbitMQ
RABBITMQ_DEFAULT_USER=collector
RABBITMQ_DEFAULT_PASS=collector_dev_password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

# Vault (mode dev uniquement, jamais en pré-prod/prod)
VAULT_DEV_ROOT_TOKEN_ID=root_dev_token
